$ = Timeline

struct Timeline {
    schema_version: int,
    name: ?bytes,
    children: []Composable,
    presentation_space_discrete_partitions: DiscretePartitionDomainMap,
    metadata_map: map[any],
    markers: []Marker,
}

struct DiscretePartitionDomainMap {
    picture: ?SampleIndexGenerator,
    audio: ?SampleIndexGenerator,
}

struct Marker {
    name: ?bytes,
    marked_range: [2]Float,
    color: bytes,
    comment: ?bytes,
}

// ContinuousInterval = [start, end] in seconds
// ControlPoint = [in, out] for curve knots
// Bounds union uses [2]Float for continuous, [2]int for discrete
union Bounds {
    .continuous: [2]Float,
    .discrete: [2]int,
}

struct Stack {
    name: ?bytes,
    children: []Composable,
    markers: []Marker,
}

struct Track {
    name: ?bytes,
    children: []Composable,
    markers: []Marker,
}

struct Gap {
    name: ?bytes,
    bounds_s: [2]Float,
    markers: []Marker,
}

struct Warp {
    name: ?bytes,
    child: *Composable,
    transform: Topology,
}

struct Transition {
    name: ?bytes,
    container: Stack,
    kind: bytes,
    bounds_s: ?[2]Float,
}

// Composable union fields are structs (not pointers)
// but children arrays contain pointers to break circular dependency
union Composable {
    .track: Track,
    .clip: Clip,
    .gap: Gap,
    .warp: Warp,
    .transition: Transition,
    .stack: Stack,
}

struct Clip {
    name: ?bytes,
    bounds_s: ?Bounds,
    media: MediaReference,
    metadata_hash: ?bytes,
    markers: []Marker,
}

struct MediaReference {
    data_reference: MediaDataReference,
    bounds_s: ?Bounds,
    domain: Domain,
    discrete_partition: ?SampleIndexGenerator,
    interpolating: ?MediaInterpolationType,
}

// Ziggy requires union fields to be struct types (not void)
union MediaDataReference {
    .uri: URIReference,
    .signal: SignalReference,
    .image_sequence: ImageSequenceReference,
    .null: struct {},
}

struct URIReference {
    target_uri: bytes,
}

struct ImageSequenceReference {
    target_url_base: bytes,
    name_prefix: bytes,
    name_suffix: bytes,
    start_frame: int,
    frame_step: int,
    frame_zero_padding: int,
    rate: Float,
    missing_frame_policy: bytes,
}

struct SignalReference {
    signal_generator: SignalGenerator,
}

// Ziggy requires union fields to be struct types
union SignalGenerator {
    .sine: struct {
        frequency_hz: Float,
    },
    .linear_ramp: struct {},
}

struct SampleIndexGenerator {
    sample_rate_hz: RateSpecifier,
    start_index: int,
}

// RateSpecifier: Int holds a single integer, Rational holds { .num, .den }
union RateSpecifier {
    .Int: int,
    .Rational: struct {
        num: int,
        den: int,
    },
}

// Ziggy requires union fields to be struct types
union Domain {
    .time: struct {},
    .picture: struct {},
    .audio: struct {},
    .metadata: struct {},
    .other: struct {
        name: bytes,
    },
}

struct Topology {
    mappings: []Mapping,
}

// Ziggy requires union fields to be struct types
union Mapping {
    .affine: MappingAffine,
    .linear: MappingLinear,
    .empty: struct {},
}

struct MappingAffine {
    input_bounds_val: [2]Float,
    input_to_output_xform: AffineTransform1D,
}

struct MappingLinear {
    input_bounds_val: [2]Float,
    knots: [][2]Float,
}

struct AffineTransform1D {
    offset: Float,
    scale: Float,
}

enum MediaInterpolationType {
    interpolate,
    snap,
    default_from_domain,
}

// Curve library types
// BezierSegment = [4][2]Float = [p0, p1, p2, p3] where each point is [in, out]
struct BezierCurve {
    segments: [][4][2]Float,
}

struct LinearCurve {
    knots: [][2]Float,
}
