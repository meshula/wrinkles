$ = Timeline

struct Timeline {
    schema_version: int,
    name: ?bytes,
    children: []Composable,
    presentation_space_discrete_partitions: DiscretePartitionDomainMap,
}

struct DiscretePartitionDomainMap {
    picture: ?SampleIndexGenerator,
    audio: ?SampleIndexGenerator,
}

// TODO: After updating to latest ziggy, change ContinuousInterval back to [2]Float
struct ContinuousInterval {
    start: Float,
    end: Float,
}

// TODO: After updating to latest ziggy, change ControlPoint back to [2]Float = [in, out]
struct ControlPoint {
    in: Float,
    out: Float,
}

// Bounds can be either continuous (time in seconds) or discrete (sample indices)
// Ziggy requires union fields to be struct types
union Bounds {
    .continuous: struct {
        start: Float,
        end: Float,
    },
    .discrete: struct {
        start: int,
        end: int,
    },
}

struct Stack {
    name: ?bytes,
    children: []Composable,
}

struct Track {
    name: ?bytes,
    children: []Composable,
}

struct Gap {
    name: ?bytes,
    bounds_s: ContinuousInterval,
}

struct Warp {
    name: ?bytes,
    child: *Composable,
    transform: Topology,
}

struct Transition {
    name: ?bytes,
    container: Stack,
    kind: bytes,
    bounds_s: ?ContinuousInterval,
}

// Composable union fields are structs (not pointers)
// but children arrays contain pointers to break circular dependency
union Composable {
    .track: Track,
    .clip: Clip,
    .gap: Gap,
    .warp: Warp,
    .transition: Transition,
    .stack: Stack,
}

struct Clip {
    name: ?bytes,
    bounds_s: ?Bounds,
    media: MediaReference,
}

struct MediaReference {
    data_reference: MediaDataReference,
    bounds_s: ?Bounds,
    domain: Domain,
    discrete_partition: ?SampleIndexGenerator,
    interpolating: ?MediaInterpolationType,
}

// Ziggy requires union fields to be struct types (not void)
union MediaDataReference {
    .uri: URIReference,
    .signal: SignalReference,
    .null: struct {},
}

struct URIReference {
    target_uri: bytes,
}

struct SignalReference {
    signal_generator: SignalGenerator,
}

// Ziggy requires union fields to be struct types
union SignalGenerator {
    .sine: struct {
        frequency_hz: Float,
    },
    .linear_ramp: struct {},
}

struct SampleIndexGenerator {
    sample_rate_hz: RateSpecifier,
    start_index: int,
}

// Ziggy requires union fields to be struct types (not primitives)
union RateSpecifier {
    .Int: struct {
        value: int,
    },
    .Rat: struct {
        num: int,
        den: int,
    },
}

// Ziggy requires union fields to be struct types
union Domain {
    .time: struct {},
    .picture: struct {},
    .audio: struct {},
    .metadata: struct {},
    .other: struct {
        name: bytes,
    },
}

struct Topology {
    mappings: []Mapping,
}

// Ziggy requires union fields to be struct types
union Mapping {
    .affine: MappingAffine,
    .linear: MappingLinear,
    .empty: struct {},
}

struct MappingAffine {
    input_bounds_val: ContinuousInterval,
    input_to_output_xform: AffineTransform1D,
}

struct MappingLinear {
    input_bounds_val: ContinuousInterval,
    knots: []ControlPoint,
}

struct AffineTransform1D {
    offset: Float,
    scale: Float,
}

enum MediaInterpolationType {
    interpolate,
    snap,
    default_from_domain,
}

// Curve library types
// BezierSegment = [4]ControlPoint = [p0, p1, p2, p3]
// TODO: After updating to latest ziggy, change back to [][4][2]Float and [][2]Float

struct BezierCurve {
    segments: [][4]ControlPoint,  // Array of segments, each segment is 4 control points
}

struct LinearCurve {
    knots: []ControlPoint,  // Array of control points
}
