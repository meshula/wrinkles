.schema_version = 1,
.name = "Sample Collection",
.description = "A sample collection containing a timeline and a standalone clip",
.children = [
    .timeline(.{
        .schema_version = 1,
        .name = "Main Timeline",
        .children = [
            .track(.{
                .name = "Video Track",
                .children = [
                    .clip(.{
                        .name = "Opening Shot",
                        .bounds_s = .continuous([
                            0,
                            5,
                        ]),
                        .media = .{
                            .data_reference = .uri(.{
                                .target_uri = "file:///media/opening.mov",
                            }),
                            .bounds_s = .continuous([
                                0,
                                10,
                            ]),
                            .domain = .picture,
                        },
                        .markers = [
                        ],
                    }),
                    .clip(.{
                        .name = "Middle Shot",
                        .bounds_s = .continuous([
                            0,
                            3,
                        ]),
                        .media = .{
                            .data_reference = .uri(.{
                                .target_uri = "file:///media/middle.mov",
                            }),
                            .bounds_s = .continuous([
                                0,
                                8,
                            ]),
                            .domain = .picture,
                        },
                        .markers = [
                        ],
                    }),
                ],
                .markers = [
                ],
            }),
        ],
        .presentation_space_discrete_partitions = .{},
        .markers = [
        ],
    }),
    .clip(.{
        .name = "Standalone B-Roll Clip",
        .bounds_s = .continuous([
            0,
            15,
        ]),
        .media = .{
            .data_reference = .uri(.{
                .target_uri = "file:///media/broll.mov",
            }),
            .bounds_s = .continuous([
                0,
                30,
            ]),
            .domain = .picture,
        },
        .markers = [
        ],
    }),
],
